# Copy to .env.local and fill in. Used by the admin panel at /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Optional: where saved content, uploaded photos and the database live (default ./data)
# DATA_DIR=/var/lib/aaisaheb
